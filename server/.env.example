# StayNear Server Production/Development Configuration Example
# Copy this file to .env and configure variables

# Port for the server to listen on
PORT=5000

# Node Environment: development or production
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local MongoDB connection)
MONGO_URI=

# JSON Web Token Secret Key for signing authentication tokens
JWT_SECRET=

# Cloudinary credentials for media/document uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS Configuration: Comma-separated list of allowed origins
# e.g., http://localhost:5173,https://your-production-app.netlify.app
ALLOWED_ORIGINS=
